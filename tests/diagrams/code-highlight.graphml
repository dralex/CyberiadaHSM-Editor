<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string"/>
  <key id="dName" for="graph" attr.name="name" attr.type="string"/>
  <key id="dName" for="node" attr.name="name" attr.type="string"/>
  <key id="dStateMachine" for="graph" attr.name="stateMachine" attr.type="string"/>
  <key id="dGeometry" for="node" attr.name="geometry"/>
  <key id="dNote" for="node" attr.name="note" attr.type="string"/>
  <key id="dData" for="node" attr.name="data" attr.type="string"/>
  <key id="dData" for="edge" attr.name="data" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">highlight</data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

name/ test-code-highlight

platformLanguage/ C++
</data>
    </node>
    <node id="idle">
      <data key="dName">idle</data>
      <data key="dData">entry/
int x = 0; // reset

TICK [x &gt; 0]/
return;
</data>
      <data key="dGeometry">
        <rect x="100.000000" y="100.000000" width="300.000000" height="200.000000"/>
      </data>
    </node>
    <node id="busy">
      <data key="dName">busy</data>
      <data key="dGeometry">
        <rect x="600.000000" y="100.000000" width="300.000000" height="200.000000"/>
      </data>
    </node>
    <node id="code">
      <data key="dNote">formal</data>
      <data key="dName">code</data>
      <data key="dData">/* shared */ static int count = 1;</data>
      <data key="dGeometry">
        <rect x="100.000000" y="400.000000" width="300.000000" height="100.000000"/>
      </data>
    </node>
    <edge id="idle-busy" source="idle" target="busy">
      <data key="dData">GO [ready]/
start("now");
</data>
    </edge>
  </graph>
</graphml>
