<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string"/>
  <key id="dName" for="graph" attr.name="name" attr.type="string"/>
  <key id="dName" for="node" attr.name="name" attr.type="string"/>
  <key id="dStateMachine" for="graph" attr.name="stateMachine" attr.type="string"/>
  <key id="dGeometry" for="graph" attr.name="geometry"/>
  <key id="dGeometry" for="node" attr.name="geometry"/>
  <key id="dSubmachineState" for="node" attr.name="submachineState" attr.type="string"/>
  <key id="dNote" for="node" attr.name="note" attr.type="string"/>
  <key id="dVertex" for="node" attr.name="vertex" attr.type="string"/>
  <key id="dData" for="node" attr.name="data" attr.type="string"/>
  <graph id="M" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">Orchestrator</data>
    <data key="dGeometry">
      <rect x="0.000000" y="0.000000" width="400.000000" height="300.000000"/>
    </data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0
</data>
    </node>
    <node id="sub">
      <data key="dSubmachineState">R</data>
      <data key="dName">Sub</data>
      <data key="dGeometry">
        <rect x="0.000000" y="0.000000" width="180.000000" height="140.000000"/>
      </data>
      <node id="sub::en">
        <data key="dVertex">entryPoint</data>
        <data key="dName">in</data>
        <data key="dGeometry">
          <point x="-90.000000" y="0.000000"/>
        </data>
      </node>
      <node id="sub::ex">
        <data key="dVertex">exitPoint</data>
        <data key="dName">out</data>
        <data key="dGeometry">
          <point x="90.000000" y="0.000000"/>
        </data>
      </node>
    </node>
  </graph>
  <graph id="R" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">Worker</data>
    <node id="R_in">
      <data key="dVertex">entryPoint</data>
      <data key="dName">in</data>
      <data key="dGeometry">
        <point x="-150.000000" y="0.000000"/>
      </data>
    </node>
    <node id="R_in2">
      <data key="dVertex">entryPoint</data>
      <data key="dName">in2</data>
      <data key="dGeometry">
        <point x="-150.000000" y="60.000000"/>
      </data>
    </node>
    <node id="R_out">
      <data key="dVertex">exitPoint</data>
      <data key="dName">out</data>
      <data key="dGeometry">
        <point x="150.000000" y="0.000000"/>
      </data>
    </node>
    <node id="R_s">
      <data key="dName">Work</data>
      <data key="dGeometry">
        <rect x="0.000000" y="0.000000" width="120.000000" height="80.000000"/>
      </data>
    </node>
  </graph>
</graphml>
