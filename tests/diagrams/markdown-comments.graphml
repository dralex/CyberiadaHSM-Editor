<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string"/>
  <key id="dName" for="graph" attr.name="name" attr.type="string"/>
  <key id="dName" for="node" attr.name="name" attr.type="string"/>
  <key id="dStateMachine" for="graph" attr.name="stateMachine" attr.type="string"/>
  <key id="dGeometry" for="node" attr.name="geometry"/>
  <key id="dNote" for="node" attr.name="note" attr.type="string"/>
  <key id="dMarkup" for="node" attr.name="markup" attr.type="string"/>
  <key id="dData" for="node" attr.name="data" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">notes</data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

name/ test-markdown-comments

platformLanguage/ Python

markupLanguage/ markdown
</data>
    </node>
    <node id="idle">
      <data key="dName">idle</data>
      <data key="dGeometry">
        <rect x="100.000000" y="100.000000" width="200.000000" height="100.000000"/>
      </data>
    </node>
    <node id="readme">
      <data key="dNote">informal</data>
      <data key="dData"># Title
- see **this** and `code`
```cpp
return 0;
```</data>
      <data key="dGeometry">
        <rect x="400.000000" y="100.000000" width="300.000000" height="160.000000"/>
      </data>
    </node>
    <node id="plain">
      <data key="dNote">informal</data>
      <data key="dMarkup">plain</data>
      <data key="dData"># not a heading here</data>
      <data key="dGeometry">
        <rect x="400.000000" y="300.000000" width="300.000000" height="60.000000"/>
      </data>
    </node>
    <node id="code">
      <data key="dNote">formal</data>
      <data key="dName">code</data>
      <data key="dData"># a Python comment</data>
      <data key="dGeometry">
        <rect x="100.000000" y="300.000000" width="200.000000" height="60.000000"/>
      </data>
    </node>
  </graph>
</graphml>
