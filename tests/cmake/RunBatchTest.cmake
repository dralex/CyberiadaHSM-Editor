# Run the editor batch mode on INPUT and require the EXPECTED exit code;
# SCRIPT adds an edit script, DUMP_GOOD compares the --dump output (written
# to OUTPUT), SAVE_OUT/SAVE_GOOD compare the saved document and re-open it;
# TEXT shows the text elements, DUMP_TEXT dumps their font and layout and
# DUMP_STACK dumps the undo stack, DUMP_TABS adds the tab line to the dump,
# DUMP_OUTLINE dumps the outline of the active Markdown tab;
# the plugin cases: PLUGIN_PATH and PLUGIN_PARAMS ('|'-separated), PLUGIN,
# LIST_PLUGINS, DUMP_PLUGIN, DUMP_SESSION and SESSION_SCRIPT (a plugin session),
# NO_DUMP (stdout without --dump), CLEAN_DIR (a fresh
# work dir), SEED (src>dst copies before the run), MARKERS (directories made before
# the run, '|'-separated), FORBID (absent from the output), SVG_METADATA (--svg-metadata),
# IMAGE_CONTAINS (the '|'-separated texts the exported image holds); the git cases:
# GIT (the program), GIT_SETUP (the steps that make the repository in CLEAN_DIR, see
# below) with TESTS_DIR (the copies come from there), DUMP_REPOSITORY

# what differs between a good file and the output: diff -u where there is one, else
# the first lines that differ (Windows has no diff)
function(show_difference good out)
  find_program(_diff_tool diff)
  if(_diff_tool)
    execute_process(COMMAND ${_diff_tool} -u ${good} ${out})
    return()
  endif()
  file(READ "${good}" _good)
  file(READ "${out}" _out)
  string(LENGTH "${_good}" _good_left)
  string(LENGTH "${_out}" _out_left)
  set(_line 1)
  set(_shown 0)
  while((_good_left GREATER 0 OR _out_left GREATER 0) AND _shown LESS 10)
    foreach(_side good out)
      string(FIND "${_${_side}}" "\n" _end)
      if(_end EQUAL -1)
        set(_${_side}_line "${_${_side}}")
        set(_${_side} "")
      else()
        string(SUBSTRING "${_${_side}}" 0 ${_end} _${_side}_line)
        math(EXPR _end "${_end} + 1")
        string(SUBSTRING "${_${_side}}" ${_end} -1 _${_side})
      endif()
      string(LENGTH "${_${_side}}" _${_side}_left)
    endforeach()
    if(NOT "x${_good_line}" STREQUAL "x${_out_line}")
      message("line ${_line}\n  good: ${_good_line}\n  got:  ${_out_line}")
      math(EXPR _shown "${_shown} + 1")
    endif()
    math(EXPR _line "${_line} + 1")
  endwhile()
endfunction()

# the masks of the comparison: a subject link's ends and underline (its "from:"/"to:"/"underline:" fields) derive
# from the drawn text layout, so they jitter sub-pixel across freetype versions; mask
# those coordinate groups before comparing, leaving element pos/rect and the rest
# byte-exact. These three tokens occur only on the scene "Subject Link:" lines - "from:"
# and "underline:" nowhere else, and "to:" elsewhere only as a quoted id ("to: 'n0'",
# never "to: (") - so the masking is global and needs no line split (the coordinates
# hold a ';', the CMake list separator, which rules a MATCHALL/foreach pass out).
function(normalize_subject_coords in_file out_file)
  file(READ "${in_file}" _text)
  string(REGEX REPLACE "from: \\([^)]*\\)" "from: (#)" _text "${_text}")
  string(REGEX REPLACE "to: \\([^)]*\\)" "to: (#)" _text "${_text}")
  string(REGEX REPLACE "underline: \\[[^]]*\\]" "underline: [#]" _text "${_text}")
  # the view state a save writes is the zoom and the scroll of the offscreen view
  string(REGEX REPLACE "cyberiadaEditorView: '[^']*'" "cyberiadaEditorView: '#'" _text "${_text}")
  # a commit hash: the bytes of the test files differ on Windows (CRLF), so do the hashes
  string(REGEX REPLACE "detached [0-9a-f]+" "detached #" _text "${_text}")
  file(WRITE "${out_file}" "${_text}")
endfunction()

# the line ends never decide a comparison: Git for Windows checks the good files out
# with CRLF, the library writes LF (compare_files --ignore-eol is CMake 3.14+)
set(_eol)
if(NOT CMAKE_VERSION VERSION_LESS 3.14)
  set(_eol --ignore-eol)
endif()

if(DEFINED CLEAN_DIR)
  file(REMOVE_RECURSE ${CLEAN_DIR})
  file(MAKE_DIRECTORY ${CLEAN_DIR})
endif()
# the repository of a git case: git isolated as the settings are - an empty configuration
# of its own, no system one, fixed names and dates, so the hashes are the same everywhere;
# no folder above the work dir is searched. A step a line: git <args> (git! when it may
# fail), copy <tests file> <file>, write <file> <text>, remove <file>
if(DEFINED GIT_SETUP)
  set(_home ${CLEAN_DIR}.home)
  file(REMOVE_RECURSE ${_home})
  file(MAKE_DIRECTORY ${_home})
  file(WRITE ${_home}/.gitconfig "")
  set(ENV{HOME} ${_home})
  set(ENV{XDG_CONFIG_HOME} ${_home}/.config)
  set(ENV{GIT_CONFIG_NOSYSTEM} 1)
  set(ENV{GIT_CONFIG_GLOBAL} ${_home}/.gitconfig)
  get_filename_component(_ceiling ${CLEAN_DIR} DIRECTORY)
  set(ENV{GIT_CEILING_DIRECTORIES} ${_ceiling})
  set(ENV{GIT_AUTHOR_NAME} "Cyberiada Test")
  set(ENV{GIT_AUTHOR_EMAIL} "test@localhost")
  set(ENV{GIT_COMMITTER_NAME} "Cyberiada Test")
  set(ENV{GIT_COMMITTER_EMAIL} "test@localhost")
  set(ENV{GIT_AUTHOR_DATE} "2026-01-01T00:00:00Z")
  set(ENV{GIT_COMMITTER_DATE} "2026-01-01T00:00:00Z")
  file(STRINGS ${GIT_SETUP} _steps)
  foreach(_step ${_steps})
    if(_step STREQUAL "" OR _step MATCHES "^#")
      continue()
    endif()
    separate_arguments(_words UNIX_COMMAND "${_step}")
    list(GET _words 0 _verb)
    list(REMOVE_AT _words 0)
    if(_verb STREQUAL "git" OR _verb STREQUAL "git!")
      execute_process(COMMAND ${GIT} ${_words} WORKING_DIRECTORY ${CLEAN_DIR}
                      RESULT_VARIABLE _result OUTPUT_QUIET ERROR_VARIABLE _error)
      if(_verb STREQUAL "git" AND NOT _result EQUAL 0)
        message(FATAL_ERROR "the setup step '${_step}' failed: ${_error}")
      endif()
    elseif(_verb STREQUAL "copy")
      list(GET _words 0 _src)
      list(GET _words 1 _dst)
      configure_file(${TESTS_DIR}/${_src} ${CLEAN_DIR}/${_dst} COPYONLY)
    elseif(_verb STREQUAL "write")
      list(GET _words 0 _dst)
      list(REMOVE_AT _words 0)
      string(REPLACE ";" " " _text "${_words}")
      file(WRITE ${CLEAN_DIR}/${_dst} "${_text}\n")
    elseif(_verb STREQUAL "remove")
      file(REMOVE ${CLEAN_DIR}/${_words})
    else()
      message(FATAL_ERROR "unknown setup step: ${_step}")
    endif()
  endforeach()
endif()
if(DEFINED SEED)
  string(REPLACE ">" ";" _seed "${SEED}")
  list(GET _seed 0 _seed_src)
  list(GET _seed 1 _seed_dst)
  configure_file(${_seed_src} ${_seed_dst} COPYONLY)
endif()
if(DEFINED MARKERS)
  string(REPLACE "|" ";" _markers "${MARKERS}")
  foreach(_marker ${_markers})
    file(MAKE_DIRECTORY ${_marker})
  endforeach()
endif()
set(_args --batch --no-text)
if(DEFINED RECONSTRUCT)
  list(APPEND _args --reconstruct)
endif()
if(DEFINED RECONSTRUCT_SM)
  list(APPEND _args --reconstruct-sm)
endif()
if(DEFINED STRICT)
  list(APPEND _args --strict)
endif()
if(DEFINED INSPECT)
  list(APPEND _args --inspect)
endif()
if(DEFINED SERVICE)
  list(APPEND _args --service)
endif()
if(DEFINED TEXT)
  list(APPEND _args --text)
endif()
if(DEFINED DUMP_TEXT)
  list(APPEND _args --dump-text)
endif()
if(DEFINED DUMP_STACK)
  list(APPEND _args --dump-stack)
endif()
if(DEFINED DUMP_TABS)
  list(APPEND _args --dump-tabs)
endif()
if(DEFINED DUMP_OUTLINE)
  list(APPEND _args --dump-outline)
endif()
if(DEFINED DUMP_REPOSITORY)
  list(APPEND _args --dump-repository)
endif()
if(DEFINED LIST_PLUGINS)
  list(APPEND _args --list-plugins)
endif()
if(DEFINED DUMP_PLUGIN)
  list(APPEND _args --dump-plugin)
endif()
if(DEFINED DUMP_SESSION)
  list(APPEND _args --dump-session)
endif()
if(DEFINED DUMP_ACTIONS)
  list(APPEND _args --dump-actions)
endif()
if(DEFINED SESSION_SCRIPT)
  list(APPEND _args --session-script ${SESSION_SCRIPT})
endif()
if(DEFINED PLUGIN_PATH)
  string(REPLACE "|" ";" _plugin_paths "${PLUGIN_PATH}")
  foreach(_p ${_plugin_paths})
    list(APPEND _args --plugin-path ${_p})
  endforeach()
endif()
if(DEFINED PLUGIN)
  list(APPEND _args --run-plugin ${PLUGIN})
endif()
if(DEFINED PLUGIN_PARAMS)
  string(REPLACE "|" ";" _plugin_params "${PLUGIN_PARAMS}")
  foreach(_p ${_plugin_params})
    list(APPEND _args --plugin-param ${_p})
  endforeach()
endif()
if(DEFINED INPUT)
  list(APPEND _args ${INPUT})
endif()
if(DEFINED SCRIPT)
  list(APPEND _args --script ${SCRIPT})
endif()
if(DEFINED SAVE_OUT)
  list(APPEND _args --save ${SAVE_OUT})
endif()
if(DEFINED SAVE_FORMAT)
  list(APPEND _args --save-format ${SAVE_FORMAT})
endif()
if(DEFINED IMAGE_OUT)
  list(APPEND _args --export ${IMAGE_OUT})
endif()
if(DEFINED SVG_METADATA)
  list(APPEND _args --svg-metadata)
endif()
set(_workdir)
if(DEFINED WORKDIR)
  set(_workdir WORKING_DIRECTORY ${WORKDIR})
endif()
if(DEFINED DUMP_GOOD)
  # the text, stack, outline and plugin cases compare their sections alone
  if(NOT DEFINED DUMP_TEXT AND NOT DEFINED DUMP_STACK AND NOT DEFINED DUMP_PLUGIN AND
     NOT DEFINED DUMP_SESSION AND NOT DEFINED LIST_PLUGINS AND NOT DEFINED NO_DUMP AND
     NOT DEFINED DUMP_OUTLINE)
    list(APPEND _args --dump)
  endif()
  execute_process(COMMAND ${BATCH_BIN} ${_args}
    ${_workdir}
    OUTPUT_FILE ${OUTPUT}
    ERROR_VARIABLE _stderr
    RESULT_VARIABLE result)
  if(DEFINED FORBID)
    file(READ ${OUTPUT} _stdout)
    string(FIND "${_stdout}${_stderr}" "${FORBID}" _forbidden)
    if(NOT _forbidden EQUAL -1)
      message(FATAL_ERROR "the output contains the forbidden text")
    endif()
  endif()
  # the error output stays visible in the test log
  if(_stderr)
    message("${_stderr}")
  endif()
else()
  execute_process(COMMAND ${BATCH_BIN} ${_args} ${_workdir} RESULT_VARIABLE result)
endif()
if(NOT result EQUAL EXPECTED)
  message(FATAL_ERROR "exit code ${result}, expected ${EXPECTED}")
endif()
if(DEFINED DUMP_GOOD)
  normalize_subject_coords(${OUTPUT} ${OUTPUT}.norm)
  normalize_subject_coords(${DUMP_GOOD} ${OUTPUT}.good.norm)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${_eol} ${OUTPUT}.norm ${OUTPUT}.good.norm
    RESULT_VARIABLE diff)
  if(NOT diff EQUAL 0)
    show_difference(${OUTPUT}.good.norm ${OUTPUT}.norm)
    message(FATAL_ERROR "dump ${OUTPUT} differs from the good file ${DUMP_GOOD}")
  endif()
endif()
if(DEFINED IMAGE_GOOD)
  execute_process(COMMAND ${BATCH_BIN} --compare ${IMAGE_OUT} ${IMAGE_GOOD}
    RESULT_VARIABLE imgdiff)
  if(NOT imgdiff EQUAL 0)
    message(FATAL_ERROR "image ${IMAGE_OUT} differs from the good file ${IMAGE_GOOD}")
  endif()
endif()
if(DEFINED IMAGE_CONTAINS)
  file(READ ${IMAGE_OUT} _image_text)
  string(REPLACE "|" ";" _needles "${IMAGE_CONTAINS}")
  foreach(_needle ${_needles})
    string(FIND "${_image_text}" "${_needle}" _at)
    if(_at EQUAL -1)
      message(FATAL_ERROR "image ${IMAGE_OUT} holds no ${_needle}")
    endif()
  endforeach()
endif()
if(DEFINED SVG_GOOD)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${_eol} ${IMAGE_OUT} ${SVG_GOOD}
    RESULT_VARIABLE svgdiff)
  if(NOT svgdiff EQUAL 0)
    show_difference(${SVG_GOOD} ${IMAGE_OUT})
    message(FATAL_ERROR "image ${IMAGE_OUT} differs from the good file ${SVG_GOOD}")
  endif()
endif()
if(DEFINED PDF_MAGIC)
  # the pdf carries a creation date, so only its shape is checked
  file(SIZE ${IMAGE_OUT} _pdf_size)
  if(_pdf_size LESS 1000)
    message(FATAL_ERROR "pdf ${IMAGE_OUT} is too small: ${_pdf_size} bytes")
  endif()
  file(READ ${IMAGE_OUT} _pdf_head LIMIT 5 HEX)
  if(NOT _pdf_head STREQUAL "255044462d")
    message(FATAL_ERROR "pdf ${IMAGE_OUT} does not start with the pdf marker")
  endif()
endif()
if(DEFINED SAVE_GOOD)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${_eol} ${SAVE_OUT} ${SAVE_GOOD}
    RESULT_VARIABLE diff)
  if(NOT diff EQUAL 0)
    show_difference(${SAVE_GOOD} ${SAVE_OUT})
    message(FATAL_ERROR "document ${SAVE_OUT} differs from the good file ${SAVE_GOOD}")
  endif()
  # write->read round trip: the saved document must open cleanly
  execute_process(COMMAND ${BATCH_BIN} --batch --no-text ${SAVE_OUT} RESULT_VARIABLE reopen)
  if(NOT reopen EQUAL 0)
    message(FATAL_ERROR "saved document ${SAVE_OUT} does not re-open (exit ${reopen})")
  endif()
endif()
