# Run the editor batch mode on INPUT and require the EXPECTED exit code;
# SCRIPT adds an edit script, DUMP_GOOD compares the --dump output (written
# to OUTPUT), SAVE_OUT/SAVE_GOOD compare the saved document and re-open it;
# TEXT shows the text elements, DUMP_TEXT dumps their font and layout and
# DUMP_STACK dumps the undo stack, DUMP_TABS adds the tab line to the dump;
# the plugin cases: PLUGIN_PATH and PLUGIN_PARAMS ('|'-separated), PLUGIN,
# LIST_PLUGINS, DUMP_PLUGIN, NO_DUMP (stdout without --dump), CLEAN_DIR (a fresh
# work dir), SEED (src>dst copies before the run), FORBID (absent from the output)

# what differs between a good file and the output: diff -u where there is one, else
# the first lines that differ (Windows has no diff)
function(show_difference good out)
  find_program(_diff_tool diff)
  if(_diff_tool)
    execute_process(COMMAND ${_diff_tool} -u ${good} ${out})
    return()
  endif()
  file(READ "${good}" _good)
  file(READ "${out}" _out)
  string(LENGTH "${_good}" _good_left)
  string(LENGTH "${_out}" _out_left)
  set(_line 1)
  set(_shown 0)
  while((_good_left GREATER 0 OR _out_left GREATER 0) AND _shown LESS 10)
    foreach(_side good out)
      string(FIND "${_${_side}}" "\n" _end)
      if(_end EQUAL -1)
        set(_${_side}_line "${_${_side}}")
        set(_${_side} "")
      else()
        string(SUBSTRING "${_${_side}}" 0 ${_end} _${_side}_line)
        math(EXPR _end "${_end} + 1")
        string(SUBSTRING "${_${_side}}" ${_end} -1 _${_side})
      endif()
      string(LENGTH "${_${_side}}" _${_side}_left)
    endforeach()
    if(NOT "x${_good_line}" STREQUAL "x${_out_line}")
      message("line ${_line}\n  good: ${_good_line}\n  got:  ${_out_line}")
      math(EXPR _shown "${_shown} + 1")
    endif()
    math(EXPR _line "${_line} + 1")
  endwhile()
endfunction()

# the line ends never decide a comparison: Git for Windows checks the good files out
# with CRLF, the library writes LF (compare_files --ignore-eol is CMake 3.14+)
set(_eol)
if(NOT CMAKE_VERSION VERSION_LESS 3.14)
  set(_eol --ignore-eol)
endif()

if(DEFINED CLEAN_DIR)
  file(REMOVE_RECURSE ${CLEAN_DIR})
  file(MAKE_DIRECTORY ${CLEAN_DIR})
endif()
if(DEFINED SEED)
  string(REPLACE ">" ";" _seed "${SEED}")
  list(GET _seed 0 _seed_src)
  list(GET _seed 1 _seed_dst)
  configure_file(${_seed_src} ${_seed_dst} COPYONLY)
endif()
set(_args --batch --no-text)
if(DEFINED RECONSTRUCT)
  list(APPEND _args --reconstruct)
endif()
if(DEFINED RECONSTRUCT_SM)
  list(APPEND _args --reconstruct-sm)
endif()
if(DEFINED STRICT)
  list(APPEND _args --strict)
endif()
if(DEFINED INSPECT)
  list(APPEND _args --inspect)
endif()
if(DEFINED SERVICE)
  list(APPEND _args --service)
endif()
if(DEFINED TEXT)
  list(APPEND _args --text)
endif()
if(DEFINED DUMP_TEXT)
  list(APPEND _args --dump-text)
endif()
if(DEFINED DUMP_STACK)
  list(APPEND _args --dump-stack)
endif()
if(DEFINED DUMP_TABS)
  list(APPEND _args --dump-tabs)
endif()
if(DEFINED LIST_PLUGINS)
  list(APPEND _args --list-plugins)
endif()
if(DEFINED DUMP_PLUGIN)
  list(APPEND _args --dump-plugin)
endif()
if(DEFINED PLUGIN_PATH)
  string(REPLACE "|" ";" _plugin_paths "${PLUGIN_PATH}")
  foreach(_p ${_plugin_paths})
    list(APPEND _args --plugin-path ${_p})
  endforeach()
endif()
if(DEFINED PLUGIN)
  list(APPEND _args --run-plugin ${PLUGIN})
endif()
if(DEFINED PLUGIN_PARAMS)
  string(REPLACE "|" ";" _plugin_params "${PLUGIN_PARAMS}")
  foreach(_p ${_plugin_params})
    list(APPEND _args --plugin-param ${_p})
  endforeach()
endif()
if(DEFINED INPUT)
  list(APPEND _args ${INPUT})
endif()
if(DEFINED SCRIPT)
  list(APPEND _args --script ${SCRIPT})
endif()
if(DEFINED SAVE_OUT)
  list(APPEND _args --save ${SAVE_OUT})
endif()
if(DEFINED SAVE_FORMAT)
  list(APPEND _args --save-format ${SAVE_FORMAT})
endif()
if(DEFINED IMAGE_OUT)
  list(APPEND _args --export ${IMAGE_OUT})
endif()
set(_workdir)
if(DEFINED WORKDIR)
  set(_workdir WORKING_DIRECTORY ${WORKDIR})
endif()
if(DEFINED DUMP_GOOD)
  # the text, stack and plugin cases compare their sections alone
  if(NOT DEFINED DUMP_TEXT AND NOT DEFINED DUMP_STACK AND NOT DEFINED DUMP_PLUGIN AND
     NOT DEFINED LIST_PLUGINS AND NOT DEFINED NO_DUMP)
    list(APPEND _args --dump)
  endif()
  execute_process(COMMAND ${BATCH_BIN} ${_args}
    ${_workdir}
    OUTPUT_FILE ${OUTPUT}
    ERROR_VARIABLE _stderr
    RESULT_VARIABLE result)
  if(DEFINED FORBID)
    file(READ ${OUTPUT} _stdout)
    string(FIND "${_stdout}${_stderr}" "${FORBID}" _forbidden)
    if(NOT _forbidden EQUAL -1)
      message(FATAL_ERROR "the output contains the forbidden text")
    endif()
  endif()
  # the error output stays visible in the test log
  if(_stderr)
    message("${_stderr}")
  endif()
else()
  execute_process(COMMAND ${BATCH_BIN} ${_args} ${_workdir} RESULT_VARIABLE result)
endif()
if(NOT result EQUAL EXPECTED)
  message(FATAL_ERROR "exit code ${result}, expected ${EXPECTED}")
endif()
if(DEFINED DUMP_GOOD)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${_eol} ${OUTPUT} ${DUMP_GOOD}
    RESULT_VARIABLE diff)
  if(NOT diff EQUAL 0)
    show_difference(${DUMP_GOOD} ${OUTPUT})
    message(FATAL_ERROR "dump ${OUTPUT} differs from the good file ${DUMP_GOOD}")
  endif()
endif()
if(DEFINED IMAGE_GOOD)
  execute_process(COMMAND ${BATCH_BIN} --compare ${IMAGE_OUT} ${IMAGE_GOOD}
    RESULT_VARIABLE imgdiff)
  if(NOT imgdiff EQUAL 0)
    message(FATAL_ERROR "image ${IMAGE_OUT} differs from the good file ${IMAGE_GOOD}")
  endif()
endif()
if(DEFINED SVG_GOOD)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${_eol} ${IMAGE_OUT} ${SVG_GOOD}
    RESULT_VARIABLE svgdiff)
  if(NOT svgdiff EQUAL 0)
    show_difference(${SVG_GOOD} ${IMAGE_OUT})
    message(FATAL_ERROR "image ${IMAGE_OUT} differs from the good file ${SVG_GOOD}")
  endif()
endif()
if(DEFINED PDF_MAGIC)
  # the pdf carries a creation date, so only its shape is checked
  file(SIZE ${IMAGE_OUT} _pdf_size)
  if(_pdf_size LESS 1000)
    message(FATAL_ERROR "pdf ${IMAGE_OUT} is too small: ${_pdf_size} bytes")
  endif()
  file(READ ${IMAGE_OUT} _pdf_head LIMIT 5 HEX)
  if(NOT _pdf_head STREQUAL "255044462d")
    message(FATAL_ERROR "pdf ${IMAGE_OUT} does not start with the pdf marker")
  endif()
endif()
if(DEFINED SAVE_GOOD)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${_eol} ${SAVE_OUT} ${SAVE_GOOD}
    RESULT_VARIABLE diff)
  if(NOT diff EQUAL 0)
    show_difference(${SAVE_GOOD} ${SAVE_OUT})
    message(FATAL_ERROR "document ${SAVE_OUT} differs from the good file ${SAVE_GOOD}")
  endif()
  # write->read round trip: the saved document must open cleanly
  execute_process(COMMAND ${BATCH_BIN} --batch --no-text ${SAVE_OUT} RESULT_VARIABLE reopen)
  if(NOT reopen EQUAL 0)
    message(FATAL_ERROR "saved document ${SAVE_OUT} does not re-open (exit ${reopen})")
  endif()
endif()
