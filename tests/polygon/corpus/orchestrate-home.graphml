            <point x="220" y="80" />
          </data>
        </node>
      </graph>
    </node>
    <edge id="e1" source="os0::ex" target="os1::en">
      <data key="dData">DONE/</data>
    </edge>
    <node id="ofin">
      <data key="dVertex">final</data>
      <data key="dGeometry">
        <point x="760" y="180" />
      </data>
    </node>
    <edge id="e2" source="os1::ex" target="ofin">
      <data key="dData">DONE/</data>
    </edge>
  </graph>
  <graph id="R0_G0" edgedefault="directed">
    <data key="dStateMachine" />
    <data key="dName">Микроволновка с грилем</data>
    <node id="R0_n0">
      <data key="dName">Нагрев</data>
      <data key="dData">entry/
heater_on();

exit/
heater_off();
</data>
      <data key="dGeometry">
        <rect x="52.808700" y="500.000000" width="579.364000" height="396.160000" />
      </data>
      <graph id="R0_n0:" edgedefault="directed">
        <node id="R0_n2">
          <data key="dName">Поджаривание</data>
          <data key="dData">entry/
arm_time_event(me-&gt;toast_color);

exit/
disarm_time_event();
</data>
          <data key="dGeometry">
            <rect x="45.068108" y="71.539001" width="429.131012" height="83.753845" />
          </data>
        </node>
        <node id="R0_n0::n0">
