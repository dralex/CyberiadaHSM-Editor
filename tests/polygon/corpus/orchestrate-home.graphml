            <point x="545.905884" y="115.195732" />
          </data>
        </node>
        <node id="R0_n0::n1">
          <data key="dName">Выпекание</data>
          <data key="dData">entry/
set_temperature(me-&gt;teperature);

exit/
set_temperature(0);
</data>
          <data key="dGeometry">
            <rect x="44.608097" y="235.503609" width="429.131012" height="83.753845" />
          </data>
        </node>
      </graph>
    </node>
