  <graph id="M0" edgedefault="directed">
    <data key="dStateMachine" />
    <data key="dName">orchestrate-home</data>
    <data key="dGeometry">
      <rect x="0" y="0" width="900" height="360" />
    </data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

geometry/ full

transitionOrder/ actionFirst

eventPropagation/ block</data>
    </node>
    <node id="oinit">
      <data key="dVertex">initial</data>
      <data key="dGeometry">
        <point x="40" y="180" />
      </data>
    </node>
    <node id="os0">
      <data key="dSubmachineState">R0_G0</data>
      <data key="dName">Run microwave</data>
      <data key="dGeometry">
        <rect x="120" y="100" width="220" height="160" />
      </data>
      <graph id="os0:" edgedefault="directed">
        <node id="os0::en">
          <data key="dVertex">entryPoint</data>
          <data key="dName">in</data>
          <data key="dGeometry">
            <point x="0" y="80" />
          </data>
        </node>
        <node id="os0::ex">
          <data key="dVertex">exitPoint</data>
          <data key="dName">out</data>
          <data key="dGeometry">
            <point x="220" y="80" />
          </data>
        </node>
      </graph>
    </node>
    <edge id="e0" source="oinit" target="os0::en" />
    <node id="os1">
      <data key="dSubmachineState">R1_G</data>
      <data key="dName">Run simple-hoover</data>
      <data key="dGeometry">
        <rect x="440" y="100" width="220" height="160" />
      </data>
      <graph id="os1:" edgedefault="directed">
        <node id="os1::en">
          <data key="dVertex">entryPoint</data>
          <data key="dName">in</data>
          <data key="dGeometry">
            <point x="0" y="80" />
          </data>
