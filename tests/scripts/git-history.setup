# two commits of a diagram, renamed between them
git init -q
git symbolic-ref HEAD refs/heads/main
copy diagrams/hierarchy.graphml h.graphml
copy texts/notes.md notes.md
write other.txt other
git add -A
git commit -q -m first
git mv h.graphml old.graphml
git commit -q -m rename
copy diagrams/geometry.graphml old.graphml
git commit -q -a -m changed
