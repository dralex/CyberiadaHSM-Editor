# a work tree with every kind of row: unchanged, modified, staged, untracked, in a folder
git init -q
git symbolic-ref HEAD refs/heads/main
copy diagrams/hierarchy.graphml h.graphml
copy texts/notes.md notes.md
copy texts/notes.md docs/guide.md
git add -A
git commit -q -m first
copy diagrams/geometry.graphml h.graphml
write added.txt added
git add added.txt
write added.txt added and changed again
write untracked.txt untracked
